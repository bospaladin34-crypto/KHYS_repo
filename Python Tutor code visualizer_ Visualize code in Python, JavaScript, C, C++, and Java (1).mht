------MultipartBoundary--OXefd1mKdcZNCyByAoqCKtQltf4fuXC8zBm7jCcSfy----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://pythontutor.com/css/styles.css

@charset "utf-8";

:root { --color-navy: #2e4566; --color-cream: #fffefd; --color-beige: #fffdfa; --color-tan: #f5f1ec; --color-sky: #e2ebf6; --color-mist: #f1f4f9; --color-teal-light: #f1f7f9; --color-teal-medium: #e2f2f6; --color-teal-dark: #d1eaf0; --color-deep-teal: #bbe0e9; --color-navy-60: rgba(46, 69, 102, 0.6); --color-body-text: #4d617d; --color-mocha: #75706d; --color-quote-bg: #f9f5ef; --color-hover-brown: #ece7e1; --color-chat-grey: #f5f5f5; --color-red: #E10C65; --font-heading: 'Radio Canada Big', sans-serif; --font-body: 'Funnel Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; --text-xs: 16px; --text-sm: 18px; --text-base: 20px; --text-lg: 24px; --text-xl: 28px; --text-2xl: 30px; --weight-regular: 400; --weight-medium: 500; --weight-semibold: 600; --weight-bold: 700; --leading-none: 1; --leading-tight: 1.1; --leading-normal: 1.4; --space-xs: 8px; --space-sm: 14px; --space-md: 20px; --space-lg: 24px; --space-xl: 40px; --space-2xl: 50px; --space-3xl: 60px; --space-4xl: 100px; --radius-sm: 6px; --radius-md: 10px; --radius-lg: 12px; --radius-xl: 20px; --radius-pill: 38px; --border-width: 1px; --max-width-content: 1240px; --min-width-desktop: 1140px; --nav-padding-top: 12px; --nav-padding-bottom: 12px; --nav-padding-x-desktop: 32px; --nav-padding-x-mobile: 24px; --nav-content-height: 24px; --nav-height: calc(var(--nav-padding-top) + var(--nav-padding-bottom) + var(--nav-content-height)); --button-padding-reduce: 2px; --shadow-card: 0px 5px 15.7px 0px rgba(245, 241, 236, 0.25); --shadow-teal: 0px 5px 15.7px 0px rgba(209, 234, 240, 0.25); --hero-gradient-extend: 50px; --hero-shift: -20px; --hero-bottom-padding-adjust: 18px; --main-top-padding-adjust: 0px; --hover-opacity: 0.85; }

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

html { font-size: 100%; -webkit-font-smoothing: antialiased; }

body { font-family: var(--font-body); font-size: var(--text-base); font-weight: var(--weight-regular); line-height: var(--leading-normal); color: var(--color-body-text); background-color: var(--color-cream); overscroll-behavior-y: none; }

.mobile-only { display: none; }

img { max-width: 100%; height: auto; display: block; }

a { color: inherit; text-decoration: none; }

button { font: inherit; cursor: pointer; }

h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading); font-weight: var(--weight-bold); line-height: var(--leading-tight); color: var(--color-navy); }

p { margin-bottom: 0px; }

.page { min-width: var(--min-width-desktop); display: flex; flex-direction: column; background-color: var(--color-cream); }

.main { display: flex; flex-direction: column; align-items: center; gap: var(--space-2xl); padding: calc(var(--space-2xl) + var(--main-top-padding-adjust)) var(--space-4xl) var(--space-4xl); }

.nav { position: sticky; top: 0px; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: var(--nav-padding-top) var(--nav-padding-x-desktop) var(--nav-padding-bottom); background-color: var(--color-beige); min-width: var(--min-width-desktop); border-bottom: 1px solid var(--color-tan); box-shadow: rgba(117, 112, 109, 0.05) 0px 4px 12.8px 0px; }

.nav--border { border-bottom: 1px solid var(--color-tan); }

.nav__left { display: flex; align-items: center; gap: var(--space-lg); }

.nav__logo { display: flex; align-items: center; gap: var(--space-sm); }

.nav__logo-icon { width: 22px; height: 31px; background-color: var(--color-navy); border-radius: 4px; }

.nav__logo-text { font-family: var(--font-heading); font-size: 20px; font-weight: var(--weight-bold); color: var(--color-navy); }

.nav__languages { display: flex; gap: var(--space-sm); }

.nav__lang-link { display: flex; align-items: center; justify-content: center; padding: 4px 12px; background-color: var(--color-tan); border: 1px solid var(--color-hover-brown); border-radius: 30px; font-family: var(--font-heading); font-size: 16px; font-weight: var(--weight-semibold); color: var(--color-navy); transition: background-color 0.2s, border-color 0.2s; }

.nav__lang-link:hover { background-color: var(--color-hover-brown); border-color: var(--color-hover-brown); }

.nav__right { display: flex; align-items: center; gap: var(--space-lg); }

.nav__link { padding: 8px 0px; font-family: var(--font-heading); font-size: 16px; font-weight: var(--weight-semibold); color: var(--color-navy); transition: opacity 0.2s; }

.nav__link:hover { opacity: var(--hover-opacity); }

.nav__link--donate { padding: 4px 14px; background-color: var(--color-navy); border: 1px solid var(--color-navy); color: var(--color-cream); border-radius: 32px; transition: background-color 0.2s, border-color 0.2s; }

.nav__link--donate:hover { background-color: var(--color-body-text); border-color: var(--color-body-text); }

.hero-wrapper { overflow: hidden; }

.hero { padding: calc(82px + var(--hero-gradient-extend)) 98px calc(82px + var(--hero-bottom-padding-adjust)); overflow: hidden; background: radial-gradient(114.56% 83.25% at 50% 100%, rgba(241, 247, 249, 0.70) 33.17%, var(--color-beige) 100%), var(--color-cream); margin-top: calc(-1 * var(--hero-shift) - var(--hero-gradient-extend)); }

.hero__content { display: flex; flex-direction: column; gap: 56px; align-items: center; }

.hero__image { width: 100%; max-width: calc(var(--max-width-content) - 2 * var(--space-xl)); position: relative; }

.hero__image-img { width: 100%; height: auto; display: block; opacity: 1; animation: 3s linear 0s 1 normal forwards running heroImageFade; }

@supports (animation: none) {
  .hero__image-img { opacity: 0; }
}

.hero__image-img--2, .hero__image-img--3, .hero__image-img--4 { position: absolute; top: 0px; left: 0px; right: 0px; }

.hero__image-img--1 { animation-delay: 1s; position: relative; }

.hero__image-img--2 { animation-delay: 1.75s; }

.hero__image-img--3 { animation-delay: 2.5s; }

.hero__image-img--4 { animation-delay: 3.25s; animation-name: heroImageFadeLast; }

@keyframes heroImageFade { 
  0% { opacity: 0; }
  12.5% { opacity: 1; }
  25% { opacity: 1; }
  37.5% { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes heroImageFadeLast { 
  0% { opacity: 0; }
  12.5% { opacity: 1; }
  100% { opacity: 1; }
}

@keyframes heroImageFadeMobile { 
  0% { opacity: 0; }
  16.67% { opacity: 1; }
  33.33% { opacity: 1; }
  50% { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes heroImageFadeMobileLast { 
  0% { opacity: 0; }
  16.67% { opacity: 1; }
  100% { opacity: 1; }
}

.hero__bottom { display: flex; align-items: center; justify-content: space-between; width: 100%; max-width: calc(var(--max-width-content) - 2 * var(--space-xl)); }

.hero__text { display: flex; flex-direction: column; gap: var(--space-xs); }

.hero__title { font-size: 48px; font-weight: var(--weight-bold); line-height: var(--leading-tight); color: var(--color-navy); max-width: 851px; }

.hero__subtitle { font-family: var(--font-heading); font-size: var(--text-lg); font-weight: var(--weight-semibold); line-height: var(--leading-tight); color: var(--color-navy); max-width: 629px; }

.hero__left { display: flex; flex-direction: column; align-items: flex-start; gap: 30px; }

.hero__stats { border-left: 3px solid var(--color-deep-teal); padding-left: 30px; padding-bottom: 2px; display: flex; flex-direction: column; gap: 12px; }

.hero__stat { font-family: var(--font-heading); font-size: var(--text-lg); font-weight: var(--weight-semibold); line-height: var(--leading-tight); }

.hero__stat-number { color: var(--color-navy); }

.hero__stat-label { color: var(--color-navy-60); }

.button { display: inline-flex; align-items: center; gap: var(--space-xs); font-family: var(--font-heading); font-weight: var(--weight-semibold); border-radius: var(--radius-pill); transition: opacity 0.2s; cursor: pointer; }

.button:hover { opacity: var(--hover-opacity); }

.button--sm { padding: calc(10px - var(--button-padding-reduce)) 16px; font-size: var(--text-sm); }

.button--lg { padding: calc(12px - var(--button-padding-reduce)) 24px; font-size: var(--text-2xl); font-weight: var(--weight-medium); gap: var(--space-sm); border-radius: 52px; }

.button--teal { background-color: var(--color-teal-medium); color: var(--color-navy); border: 1px solid var(--color-deep-teal); }

.button--teal:hover { opacity: 1; background-color: var(--color-teal-dark); border-color: var(--color-teal-dark); }

.button--teal:hover .button__arrow { transform: translate3d(2px, 0px, 0px); }

.button--teal-dark { background-color: var(--color-teal-dark); color: var(--color-navy); border: 1px solid var(--color-deep-teal); border-radius: 39px; }

.button--teal-dark:hover { opacity: 1; background-color: var(--color-deep-teal); border-color: var(--color-deep-teal); }

.button--teal-dark:hover .button__arrow { transform: translate3d(2px, 0px, 0px); }

.button__arrow { width: 15px; height: 11px; display: flex; align-items: center; justify-content: center; transition: transform 0.2s; will-change: transform; backface-visibility: hidden; }

.button__arrow svg { width: 100%; height: 100%; }

.button__arrow-sm { display: none; }

.button__arrow-lg { display: block; }

.button__arrow--lg { width: 27px; height: 21px; }

.card { width: 100%; max-width: var(--max-width-content); border-radius: var(--radius-xl); }

.card--intro { padding: 30px var(--space-xl) var(--space-xs); }

.card--intro .card__content { display: flex; gap: var(--space-3xl); align-items: flex-start; }

.card--intro .card__text { flex: 1 1 0%; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-lg); }

.card--intro .card__media { flex: 1.1 1 0%; min-width: 0px; display: flex; align-items: center; justify-content: center; }

.card__title { font-size: var(--text-xl); margin-bottom: var(--space-sm); }

.card__body { font-size: var(--text-base); line-height: var(--leading-normal); color: var(--color-body-text); }

.card__body p { margin-bottom: 1em; }

.card__body p:last-child { margin-bottom: 0px; }

.card__body a { text-decoration: underline 1px; text-underline-offset: 2px; text-decoration-skip-ink: auto; }

.card__body a:hover { opacity: var(--hover-opacity); }

